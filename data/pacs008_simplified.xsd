<?xml version="1.0" encoding="UTF-8"?>
<!--
  SIMPLIFIED practice schema for pacs.008, written for this exercise only.
  The official ISO 20022 schema is much larger (download it from iso20022.org).
  This one keeps a few real rules so you can see what XSD validation catches:
  required elements and their order, BIC and UETR patterns, a non-negative amount
  with a 3-letter currency, dates, and allowed code values.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:iso:std:iso:20022:tech:xsd:pacs.008.001.08"
           targetNamespace="urn:iso:std:iso:20022:tech:xsd:pacs.008.001.08"
           elementFormDefault="qualified">

  <xs:element name="Document">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="FIToFICstmrCdtTrf" type="FIToFICstmrCdtTrf"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="FIToFICstmrCdtTrf">
    <xs:sequence>
      <xs:element name="GrpHdr" type="GroupHeader"/>
      <xs:element name="CdtTrfTxInf" type="CreditTransferTransaction" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="GroupHeader">
    <xs:sequence>
      <xs:element name="MsgId" type="Max35Text"/>
      <xs:element name="CreDtTm" type="xs:dateTime"/>
      <xs:element name="NbOfTxs" type="xs:positiveInteger"/>
      <xs:element name="SttlmInf">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="SttlmMtd">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:enumeration value="INDA"/>
                  <xs:enumeration value="INGA"/>
                  <xs:enumeration value="COVE"/>
                  <xs:enumeration value="CLRG"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CreditTransferTransaction">
    <xs:sequence>
      <xs:element name="PmtId">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="InstrId" type="Max35Text" minOccurs="0"/>
            <xs:element name="EndToEndId" type="Max35Text"/>
            <xs:element name="UETR" type="UUIDv4"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="IntrBkSttlmAmt" type="ActiveCurrencyAndAmount"/>
      <xs:element name="IntrBkSttlmDt" type="xs:date"/>
      <xs:element name="ChrgBr">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="DEBT"/>
            <xs:enumeration value="CRED"/>
            <xs:enumeration value="SHAR"/>
            <xs:enumeration value="SLEV"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="Dbtr" type="Party"/>
      <xs:element name="DbtrAgt" type="Agent"/>
      <xs:element name="CdtrAgt" type="Agent"/>
      <xs:element name="Cdtr" type="Party"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Party">
    <xs:sequence>
      <xs:element name="Nm" type="Max140Text"/>
      <xs:element name="PstlAdr" type="PostalAddress" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Every part is optional here, like in the real standard. AdrLine is the
       old unstructured style: schema-valid, but business rules may reject it. -->
  <xs:complexType name="PostalAddress">
    <xs:sequence>
      <xs:element name="StrtNm" type="Max70Text" minOccurs="0"/>
      <xs:element name="BldgNb" type="Max16Text" minOccurs="0"/>
      <xs:element name="PstCd" type="Max16Text" minOccurs="0"/>
      <xs:element name="TwnNm" type="Max35Text" minOccurs="0"/>
      <xs:element name="Ctry" type="CountryCode" minOccurs="0"/>
      <xs:element name="AdrLine" type="Max70Text" minOccurs="0" maxOccurs="7"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Agent">
    <xs:sequence>
      <xs:element name="FinInstnId">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="BICFI" type="BICFIIdentifier"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ActiveCurrencyAndAmount">
    <xs:simpleContent>
      <xs:extension base="AmountValue">
        <xs:attribute name="Ccy" type="CurrencyCode" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:simpleType name="AmountValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:fractionDigits value="5"/>
      <xs:totalDigits value="18"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CurrencyCode">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z]{3}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CountryCode">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="BICFIIdentifier">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z0-9]{4}[A-Z]{2}[A-Z0-9]{2}([A-Z0-9]{3})?"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="UUIDv4">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Max16Text">
    <xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="16"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Max35Text">
    <xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="35"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Max70Text">
    <xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="70"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Max140Text">
    <xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="140"/></xs:restriction>
  </xs:simpleType>
</xs:schema>
